# Copy to .env.local and fill in from Firebase Console → Project settings → Your apps → Web app.
# NEXT_PUBLIC_* values are inlined into the browser bundle; they are not secrets (access is enforced by Firestore rules).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional, dev only: send Firestore reads/writes to the local emulator (firebase emulators:start --only firestore --project founder-fit-6a455; local only, nothing is deployed).
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Optional, server-only: Gemini on Vertex AI for /api/narrative. Uses Application Default Credentials (no API key):
#   gcloud auth application-default login
# Defaults shown; switch GOOGLE_CLOUD_LOCATION to "global" if the model returns 404 in us-central1.
# GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_MODEL=gemini-3.5-flash

# Optional, server-only: who may use the app (comma-separated, case-insensitive). With both empty, any account
# with a verified email is allowed in development; production (NODE_ENV=production) allows nobody.
# FOUNDERFIT_ALLOWED_DOMAINS=sciencewerx.org
# FOUNDERFIT_ALLOWED_EMAILS=
# Optional, server-only: narrative calls per user per UTC day (default 30).
# FOUNDERFIT_NARRATIVE_DAILY_LIMIT=30

# Optional, local dev only: use the Gemini Developer API instead of Vertex AI. Get a key at https://aistudio.google.com/apikey.
# Server-only: never prefix it with NEXT_PUBLIC_, never commit it, never put it in apphosting.yaml (ignored in production).
GEMINI_API_KEY=

# Optional, server-only: ScienceWerx observability token (portal → Monitoring). Leave empty locally so nothing is sent.
OBSERVABILITY_TOKEN=

# Optional, server-only: ScienceWerx Connect (see README). Leave empty to turn it off locally.
# CONNECT_KEY is this app's secret caller key: "swc_" + 43 base64url chars, e.g.
#   node -e 'console.log("swc_" + require("crypto").randomBytes(32).toString("base64url"))'
# CONNECT_PEERS lists peers to call (https, or http on localhost): name=base-url, comma-separated.
# CONNECT_CALLERS lists who may call us: name:sha256hex-of-their-key:summary, comma-separated.
#   node -e 'console.log(require("crypto").createHash("sha256").update(process.argv[1]).digest("hex"))' swc_...
# FOUNDERFIT_PUBLIC_URL is the link on our card in other apps (default: the production URL).
CONNECT_KEY=
# CONNECT_PEERS=istartup=http://localhost:3001
# CONNECT_CALLERS=istartup:<sha256hex>:summary
# FOUNDERFIT_PUBLIC_URL=http://localhost:3000
