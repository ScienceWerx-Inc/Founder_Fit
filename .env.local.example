# Copy to .env.local and fill in from Firebase Console → Project settings → Your apps → Web app.
# NEXT_PUBLIC_* values are inlined into the browser bundle; they are not secrets (access is enforced by Firestore rules).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional, dev only: send Firestore reads/writes to the local emulator (firebase emulators:start --only firestore --project founder-fit-6a455; local only, nothing is deployed).
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Optional, server-only: Gemini on Vertex AI for /api/narrative. Uses Application Default Credentials (no API key):
#   gcloud auth application-default login
# Defaults shown; switch GOOGLE_CLOUD_LOCATION to "global" if the model returns 404 in us-central1.
# GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_MODEL=gemini-3.5-flash
